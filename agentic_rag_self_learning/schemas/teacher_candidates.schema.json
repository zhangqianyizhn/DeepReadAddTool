{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TeacherPromptCandidateBatch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "round",
    "global_diagnosis",
    "failure_clusters",
    "candidates"
  ],
  "properties": {
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "global_diagnosis": {
      "type": "string",
      "minLength": 1
    },
    "failure_clusters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "estimated_frequency", "actionable"],
        "properties": {
          "name": {"type": "string"},
          "description": {"type": "string"},
          "estimated_frequency": {"type": "integer", "minimum": 0},
          "actionable": {"type": "boolean"}
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "strategy",
          "instructions",
          "target_failure_modes",
          "expected_effect",
          "regression_risks",
          "specificity_audit"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^r[0-9]+_[a-z0-9_]+$"
          },
          "strategy": {
            "type": "string",
            "enum": [
              "minimal_patch",
              "retrieval_discipline",
              "reasoning_verification"
            ]
          },
          "instructions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "target_failure_modes": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "expected_effect": {"type": "string"},
          "regression_risks": {
            "type": "array",
            "items": {"type": "string"}
          },
          "specificity_audit": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contains_company_names",
              "contains_case_answers_or_numbers",
              "contains_doc_or_node_ids",
              "estimated_prompt_tokens"
            ],
            "properties": {
              "contains_company_names": {"const": false},
              "contains_case_answers_or_numbers": {"const": false},
              "contains_doc_or_node_ids": {"const": false},
              "estimated_prompt_tokens": {
                "type": "integer",
                "minimum": 1,
                "maximum": 800
              }
            }
          }
        }
      }
    }
  }
}
